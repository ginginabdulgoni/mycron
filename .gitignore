# Laravel (inside mycron/laravel)
laravel/vendor
laravel/.env
laravel/.env.*
laravel/storage/*.key
laravel/storage/app/public
laravel/bootstrap/cache/*.php

# Laravel IDE Helper
laravel/.phpstorm.meta.php
laravel/_ide_helper.php
laravel/_ide_helper_models.php

# Node.js (inside mycron/node-worker)
node-worker/node_modules
node-worker/.env
node-worker/*.log

# OS / Editor files
.DS_Store
Thumbs.db
*.swp
*.swo
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.zip

# Composer / NPM lock files (optional, can be versioned if needed)
laravel/composer.lock
node-worker/package-lock.json
node-worker/yarn.lock

# Catatan akses server (rahasia)
server.md

# Laravel runtime files
laravel/storage/logs/*
!laravel/storage/logs/.gitignore
laravel/storage/framework/cache/*
!laravel/storage/framework/cache/.gitignore
laravel/storage/framework/sessions/*
!laravel/storage/framework/sessions/.gitignore
laravel/storage/framework/views/*
!laravel/storage/framework/views/.gitignore
